"use client";

import React, { useState, useEffect, useRef, useMemo } from "react";
import { format } from "date-fns";
import { Phone, MapPin, Tag, Check, Link as LinkIcon, FileText, ExternalLink, Flag, CalendarClock, Search, Copy } from "lucide-react";
import { useSubCategorySettings } from "@/components/providers/SubCategoryProvider";
import { toast } from "sonner";
import { getCategoryDetails } from "@/lib/categoryUtils";

// Database types
export type StagedTicket = {
  id: string;
  ticket_id: string;
  date: string;
  contact_name: string | null;
  phone: string | null;
  address1: string | null;
  pincode: string | null;
  category: string | null;
  sub_category: string | null;
  ticket_age: number | null;
  raw_tags: string | null;
  batch_id: string | null;
};

export type TicketAnnotation = {
  ticket_id: string;
  contact_name?: string;
  location?: string;
  pincode?: string;
  notes?: string;
  link?: string;
  priority_tag?: string;
};

export type EnrichedTicket = StagedTicket & {
  annotation: TicketAnnotation | null;
};

type Props = {
  data: EnrichedTicket[];
};

export function ActiveTicketsTable({ data }: Props) {
  const subCategories = useSubCategorySettings();
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [searchQuery, setSearchQuery] = useState("");
  const searchInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "k" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        searchInputRef.current?.focus();
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  const filteredData = useMemo(() => {
    if (!searchQuery.trim()) return data;
    const lowerQuery = searchQuery.toLowerCase();
    return data.filter((t) => {
      const matchName = (t.annotation?.contact_name || t.contact_name || "").toLowerCase().includes(lowerQuery);
      const matchId = t.ticket_id.toLowerCase().includes(lowerQuery);
      const matchPhone = (t.phone || "").toLowerCase().includes(lowerQuery);
      const matchSub = (t.sub_category || "").toLowerCase().includes(lowerQuery);
      const matchTags = (t.raw_tags || "").toLowerCase().includes(lowerQuery);
      const matchAddress = (t.address1 || "").toLowerCase().includes(lowerQuery);
      const matchLoc = (t.annotation?.location || "").toLowerCase().includes(lowerQuery);
      return matchName || matchId || matchPhone || matchSub || matchTags || matchAddress || matchLoc;
    });
  }, [data, searchQuery]);

  const toggleSelectAll = () => {
    if (selectedIds.size === filteredData.length && filteredData.length > 0) {
      setSelectedIds(new Set());
    } else {
      setSelectedIds(new Set(filteredData.map((t) => t.id)));
    }
  };

  const toggleSelect = (id: string) => {
    const newSet = new Set(selectedIds);
    if (newSet.has(id)) {
      newSet.delete(id);
    } else {
      newSet.add(id);
    }
    setSelectedIds(newSet);
  };

  // Helper to get initials for avatar
  const getInitials = (name: string | null) => {
    if (!name) return "U";
    return name.substring(0, 2).toUpperCase();
  };

  // Helper to generate a consistent color for a tag
  const getTagColor = (tag: string) => {
    const colors = [
      "bg-blue-500/10 text-blue-600 border-blue-500/20 dark:text-blue-400",
      "bg-emerald-500/10 text-emerald-600 border-emerald-500/20 dark:text-emerald-400",
      "bg-indigo-500/10 text-indigo-600 border-indigo-500/20 dark:text-indigo-400",
      "bg-rose-500/10 text-rose-600 border-rose-500/20 dark:text-rose-400",
      "bg-cyan-500/10 text-cyan-600 border-cyan-500/20 dark:text-cyan-400",
      "bg-violet-500/10 text-violet-600 border-violet-500/20 dark:text-violet-400",
      "bg-orange-500/10 text-orange-600 border-orange-500/20 dark:text-orange-400",
    ];
    let hash = 0;
    for (let i = 0; i < tag.length; i++) {
      hash = tag.charCodeAt(i) + ((hash << 5) - hash);
    }
    return colors[Math.abs(hash) % colors.length];
  };

  // Helper to render tags
  const renderTags = (tagsStr: string | null) => {
    if (!tagsStr || tagsStr.trim() === "-") return null;
    const tags = tagsStr.split(",").map((t) => t.trim()).filter(t => t && t !== "-");
    if (tags.length === 0) return null;

    return (
      <div className="flex flex-wrap gap-1">
        {tags.map((tag) => (
          <span
            key={tag}
            className={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold border truncate max-w-[90px] ${getTagColor(tag)}`}
            title={tag}
          >
            {tag}
          </span>
        ))}
      </div>
    );
  };

  return (
    <div className="w-full h-full flex flex-col gap-4">
      {/* Search Header */}
      <div className="flex items-center">
        <div className="relative w-full max-w-sm flex items-center">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground z-10 pointer-events-none" />
          <input
            ref={searchInputRef}
            type="text"
            placeholder="Search tickets..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="w-full bg-card/60 backdrop-blur-xl border border-white/20 dark:border-white/10 shadow-sm rounded-lg pl-9 pr-12 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary transition-all"
          />
          <div className="absolute right-2.5 flex items-center gap-1 pointer-events-none">
            <kbd className="inline-flex items-center justify-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground h-5">
              <span className="text-xs">⌘</span>K
            </kbd>
          </div>
        </div>
      </div>
      
      {/* Table Card */}
      <div className="w-full flex-1 flex flex-col bg-card/60 backdrop-blur-xl border border-white/20 dark:border-white/10 shadow-sm rounded-xl overflow-hidden min-h-0">
      
      <div className="overflow-auto flex-1 custom-scrollbar">
        {/* Table width needs to be very large to accommodate 14 columns properly without crushing them */}
        <table className="w-full text-left border-collapse min-w-[2000px]">
          <thead className="divide-y divide-border/50">
            <tr className="border-b border-border/50 bg-muted/30 divide-x divide-border/50">
              {/* 1. Check mark col (Frozen Left) */}
              <th className="px-4 py-3 sticky top-0 left-0 z-20 bg-muted/95 shadow-sm backdrop-blur-xl border-r border-border/50 w-12">
                <div className="flex items-center justify-center">
                  <input
                    type="checkbox"
                    className="w-4 h-4 rounded border-border/80 text-primary focus:ring-primary accent-primary cursor-pointer"
                    checked={selectedIds.size > 0 && selectedIds.size === filteredData.length}
                    ref={(input) => {
                      if (input) {
                        input.indeterminate = selectedIds.size > 0 && selectedIds.size < filteredData.length;
                      }
                    }}
                    onChange={toggleSelectAll}
                  />
                </div>
              </th>
              
              {/* 2. Priority Tag col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap w-12 text-center" title="Priority">
                <Flag className="w-3.5 h-3.5 mx-auto" />
              </th>
              
              {/* 3. Schedule Status col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap w-12 text-center" title="Schedule Status">
                <CalendarClock className="w-3.5 h-3.5 mx-auto" />
              </th>
              
              {/* 4. Date col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Date</th>
              
              {/* 5. Age col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Age</th>
              
              {/* 6. Tag cols */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap w-24">Tags</th>
              
              {/* 7. Ops. */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Ops.</th>
              
              {/* 8. Ticket ID */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Ticket ID</th>
              
              {/* 9. Name */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Name</th>
              
              {/* 10. Phone */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 whitespace-nowrap">Phone</th>
              
              {/* 11. Location, pin col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 min-w-[200px]">Location</th>
              
              {/* 12. Notes cols */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 min-w-[200px]">Notes</th>
              
              {/* 13. Address col */}
              <th className="px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider sticky top-0 bg-muted/90 shadow-sm backdrop-blur-xl z-10 min-w-[250px]">Address</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-border/50">
            {filteredData.length === 0 ? (
              <tr>
                <td colSpan={13} className="px-4 py-12 text-center">
                  <div className="flex flex-col items-center justify-center text-muted-foreground">
                    <Tag className="w-12 h-12 mb-3 opacity-20" />
                    <p className="text-base font-medium text-foreground">
                      {searchQuery ? "No tickets match your search" : "No active tickets found"}
                    </p>
                    <p className="text-sm mt-1">
                      {searchQuery ? "Try adjusting your filters" : "Upload a manifest to view staged tickets here."}
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              filteredData.map((ticket) => {
                const { Icon, color } = getCategoryDetails(ticket.sub_category, subCategories);
                const isSelected = selectedIds.has(ticket.id);
                
                const displayName = ticket.annotation?.contact_name || ticket.contact_name || "Unknown";
                
                // Location & Pin strictly from annotations
                const displayLocation = ticket.annotation?.location || "";
                const displayPin = ticket.annotation?.pincode || "";
                
                // Address strictly from source ticket
                const displayAddress = ticket.address1 || "No address";
                const displayBasePincode = ticket.pincode || "";
                
                return (
                  <tr 
                    key={ticket.id} 
                    className="hover:bg-muted/20 transition-colors group divide-x divide-border/50"
                  >
                    {/* 1. Check mark col (Frozen Left) */}
                    <td className="px-4 py-3 align-middle sticky left-0 z-10 bg-card/95 backdrop-blur-xl border-r border-border/50">
                      <div className="flex items-center justify-center">
                        <input
                          type="checkbox"
                          checked={isSelected}
                          onChange={() => toggleSelect(ticket.id)}
                          className="w-4 h-4 rounded border-border/80 text-primary focus:ring-primary accent-primary cursor-pointer"
                        />
                      </div>
                    </td>
                    
                    {/* 2. Priority Tag col */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap text-center">
                      {ticket.annotation?.priority_tag ? (
                        <div className="w-5 h-5 rounded mx-auto flex items-center justify-center bg-amber-500/10 text-amber-600 border border-amber-500/20" title={ticket.annotation.priority_tag}>
                          <Flag className="w-3 h-3" />
                        </div>
                      ) : (
                        <span className="text-muted-foreground/30 text-xs">-</span>
                      )}
                    </td>
                    
                    {/* 3. Schedule Status col (Placeholder) */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap text-center">
                      <span className="text-muted-foreground/30 text-xs">-</span>
                    </td>
                    
                    {/* 4. Date col */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap">
                      <div className="text-xs font-mono font-medium text-foreground">
                        {format(new Date(ticket.date), "MMM d, yyyy")}
                      </div>
                    </td>
                    
                    {/* 5. Age col */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap">
                      <div className="text-xs font-medium">
                        {ticket.ticket_age ? (
                          <span className={ticket.ticket_age > 3 ? "text-rose-500" : "text-muted-foreground"}>
                            {ticket.ticket_age} {ticket.ticket_age === 1 ? 'day' : 'days'}
                          </span>
                        ) : (
                          <span className="text-emerald-500">New</span>
                        )}
                      </div>
                    </td>
                    
                    {/* 6. Tag cols */}
                    <td className="px-4 py-3 align-middle w-24 max-w-[120px]">
                      {renderTags(ticket.raw_tags)}
                    </td>
                    
                    {/* 7. Ops. */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap">
                      <div 
                        className="flex items-center justify-center"
                        style={{ color }}
                        title={ticket.sub_category || "Uncategorized"}
                      >
                        <Icon className="w-5 h-5" />
                      </div>
                    </td>
                    
                    {/* 8. Ticket ID */}
                    <td className="px-4 py-3 align-middle">
                      <button 
                        onClick={() => {
                          navigator.clipboard.writeText(ticket.ticket_id);
                          toast.success(`Copied ${ticket.ticket_id}`);
                        }}
                        className="font-mono text-xs font-medium text-foreground bg-secondary/30 hover:bg-secondary/60 hover:text-primary transition-colors inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded cursor-pointer group/copy"
                        title="Click to copy"
                      >
                        {ticket.ticket_id}
                        <Copy className="w-3 h-3 opacity-0 group-hover/copy:opacity-100 transition-opacity" />
                      </button>
                    </td>
                    
                    {/* 9. Name */}
                    <td className="px-4 py-3 align-middle min-w-[150px]">
                      <div className="text-xs font-medium text-foreground line-clamp-2">
                        {displayName}
                      </div>
                    </td>
                    
                    {/* 10. Phone */}
                    <td className="px-4 py-3 align-middle whitespace-nowrap">
                      {ticket.phone ? (
                        <div className="text-xs font-mono text-foreground">
                          {ticket.phone}
                        </div>
                      ) : (
                        <span className="text-muted-foreground/30 text-xs">-</span>
                      )}
                    </td>
                    
                    {/* 11. Location, pin col (Annotations) */}
                    <td className="px-4 py-3 align-middle min-w-[200px]">
                      {(displayLocation || displayPin) ? (
                        <div className="flex items-start gap-1.5">
                          <MapPin className="w-3.5 h-3.5 text-primary shrink-0 mt-0.5" />
                          <div>
                            <div className="text-xs text-foreground line-clamp-2 leading-tight">
                              {displayLocation || "-"}
                            </div>
                            {displayPin && (
                              <div className="text-[11px] font-medium text-muted-foreground mt-1">
                                {displayPin}
                              </div>
                            )}
                          </div>
                        </div>
                      ) : (
                        <span className="text-muted-foreground/30 text-xs">-</span>
                      )}
                    </td>
                    
                    {/* 12. Notes cols */}
                    <td className="px-4 py-3 align-middle min-w-[200px]">
                      {ticket.annotation?.notes ? (
                        <div className="flex items-start gap-1.5 text-xs text-muted-foreground">
                          <FileText className="w-3.5 h-3.5 shrink-0 mt-0.5 opacity-50" />
                          <span className="line-clamp-2">{ticket.annotation.notes}</span>
                        </div>
                      ) : (
                        <span className="text-muted-foreground/30 text-xs">-</span>
                      )}
                    </td>
                    
                    {/* 13. Address col (Source Ticket) */}
                    <td className="px-4 py-3 align-middle min-w-[250px]">
                      <div className="text-xs text-muted-foreground line-clamp-2" title={`${displayAddress} ${displayBasePincode}`}>
                        {displayAddress} {displayBasePincode ? `- ${displayBasePincode}` : ''}
                      </div>
                    </td>
                    
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
    </div>
  );
}
